# Copy this file to .env.analytics. The real file is ignored by Git.
#
# Microsoft Clarity:
# Project settings > Data Export > Generate new API token.
CLARITY_API_TOKEN=

# Cloudflare:
# Use a read-only token restricted to the samfa12.com zone with:
# Account > Account Analytics > Read,
# Zone > Analytics > Read, and
# Zone > Zone > Read permissions.
CLOUDFLARE_API_TOKEN=

# Optional. If omitted, the collector resolves the zone by hostname.
CLOUDFLARE_ZONE_ID=

ANALYTICS_HOSTNAME=samfa12.com
CLOUDFLARE_LOOKBACK_DAYS=8
