# Copy this file to .env.marketplace for local marketplace-statistics runs.
# The real file is ignored by Git. Never commit provider credentials or a
# downloaded Google service-account JSON key.

# itch.io account API key. Settings > API keys.
ITCH_API_KEY=

# Steamworks Financial Web API key for the dedicated Financial API Group.
STEAM_FINANCIAL_API_KEY=

# Google Play service account: use ONE local option, never both.
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_PATH=/absolute/path/to/service-account.json
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Copy the exact URI from Play Console > Download reports > Financial. It should
# resemble gs://pubsite_prod_rev_...; the collector derives the sales/ prefix.
GOOGLE_PLAY_SALES_URI=
