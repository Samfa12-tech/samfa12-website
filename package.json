{
  "name": "samfa12-website",
  "private": true,
  "type": "module",
  "scripts": {
    "build:content": "node scripts/build-content.mjs",
    "check:content": "node scripts/build-content.mjs --check",
    "validate:seo": "node scripts/validate-seo.mjs",
    "audit:indexing": "node scripts/indexing-audit.mjs",
    "test:content": "node --test tests/content.test.mjs tests/indexing-audit.test.mjs",
    "bump:cache": "node scripts/bump-cache-version.mjs",
    "fetch:thumbnails": "node scripts/fetch-thumbnails.mjs",
    "sync:pocket-apps": "node scripts/sync-pocket-apps.js",
    "sync:what-would-win": "node scripts/sync-what-would-win.mjs",
    "verify:what-would-win-pages": "node scripts/verify-what-would-win-pages.mjs",
    "sync:briarhold": "node scripts/sync-briarhold.mjs",
    "verify:briarhold-pages": "node scripts/verify-briarhold-pages.mjs",
    "validate:site": "node scripts/validate-site.mjs",
    "dev:handoff": "node scripts/serve-pocket-handoff-dev.mjs",
    "validate:catalogue": "node scripts/validate-catalogue.mjs",
    "analytics:check": "node scripts/collect-analytics.mjs --check",
    "analytics:collect": "node scripts/collect-analytics.mjs",
    "analytics:report": "node scripts/report-analytics.mjs",
    "test:analytics": "node --test tests/analytics-bridge.test.mjs",
    "marketplace:check": "node scripts/check-marketplace-config.mjs",
    "marketplace:update": "node scripts/update-marketplace-stats.mjs",
    "marketplace:verify-providers": "node scripts/verify-marketplace-providers.mjs",
    "marketplace:import-steam-csv": "node scripts/import-steam-sales-csv.mjs",
    "marketplace:import-kdp": "node scripts/import-kdp-reports.mjs",
    "test:marketplace": "node --test tests/marketplace-stats.test.mjs",
    "test:handoff-relay": "node --test tests/pocket-audio-handoff-relay.test.mjs",
    "social:dry-run": "SOCIAL_ACTION=dry-run node scripts/social-post.mjs",
    "social:preview-week": "SOCIAL_ACTION=preview-week node scripts/social-post.mjs",
    "social:list-channels": "SOCIAL_ACTION=list-channels node scripts/social-post.mjs",
    "social:schedule-week": "SOCIAL_ACTION=schedule-week node scripts/social-post.mjs",
    "setup:handoff-kv": "npx wrangler kv namespace create HANDOFFS --config workers/pocket-audio-handoff/wrangler.toml --binding HANDOFFS --update-config && npx wrangler kv namespace create HANDOFFS --preview --config workers/pocket-audio-handoff/wrangler.toml --binding HANDOFFS --update-config",
    "deploy:handoff-relay": "npx wrangler deploy --config workers/pocket-audio-handoff/wrangler.toml",
    "verify:handoff-live": "node scripts/verify-pocket-handoff-live.mjs"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.0.1",
    "csv-parse": "^6.1.0",
    "fflate": "^0.8.2"
  }
}
